# =============================================================================
# terraform.tfvars.example — BurstLab Gen 6 (AL2023 + Slurm 25.11)
# =============================================================================
# Copy to terraform.tfvars and fill in the required values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Required values (no defaults):
#   key_name      — your EC2 key pair name
#   head_node_ami — AMI built by Packer (see below)
# =============================================================================

# AWS configuration
aws_region  = "us-west-2"
aws_profile = "aws"

# Cluster name — distinguishes Gen 6 from the other generations in the same account.
cluster_name = "burstlab-gen6"

# SSH key pair name (REQUIRED)
key_name = "your-key-pair-name"

# Head node AMI (REQUIRED)
# Build with: AWS_PROFILE=aws packer build ami/alinux2023-slurm2511.pkr.hcl
# Get the latest built AMI:
#   AWS_PROFILE=aws aws ec2 describe-images --owners self \
#     --filters 'Name=name,Values=burstlab-gen6-*' \
#     --query 'sort_by(Images, &CreationDate)[-1].{ID:ImageId,Name:Name}' \
#     --output table
#
# NOTE: the base AL2023 source AMI is Amazon-owned and available in every region.
# The Packer template resolves it via the 'amazon' owner alias, so no manual AMI
# lookup is needed to build. To confirm the base image if you want:
#   AWS_PROFILE=aws aws ec2 describe-images --owners amazon \
#     --filters 'Name=name,Values=al2023-ami-2023.*-x86_64' \
#     --query 'sort_by(Images, &CreationDate)[-1].Name' --output text
head_node_ami = "ami-XXXXXXXX"

# Instance types (optional — defaults shown)
# head_node_instance_type    = "m7a.2xlarge"
# compute_node_instance_type = "m7a.2xlarge"
# burst_node_instance_type   = "m7a.2xlarge"

# Cluster size (optional — defaults shown)
# compute_node_count = 4
# max_burst_nodes    = 10
